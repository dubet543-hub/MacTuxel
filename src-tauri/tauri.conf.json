{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MacTuxel",
  "mainBinaryName": "MacTuxel",
  "version": "0.1.0",
  "identifier": "com.tushar.mactuxel",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MacTuxel",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "tabbingIdentifier": "MacTuxel",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 20
        }
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "public.app-category.productivity",
    "shortDescription": "Offline-first spreadsheet editor",
    "longDescription": "MacTuxel is an offline-first spreadsheet editor for Apple Silicon Macs.",
    "copyright": "© 2026 Tushar",
    "publisher": "Tushar",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
